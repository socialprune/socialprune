# Store text with LF line endings and check it out with LF on every platform,
# so Windows and Unix contributors produce identical diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Synthetic fixture archives are binary.
*.zip binary
