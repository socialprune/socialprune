{
  "name": "socialprune",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "schemas:generate": "node src/cli/schema-files.ts generate",
    "schemas:check": "node src/cli/schema-files.ts check",
    "test:e2e": "pnpm --filter @socialprune/web build:review && playwright test",
    "test:delete": "vitest run --config e2e/delete.vitest.config.ts",
    "test:context": "vitest run --config e2e/context.vitest.config.ts",
    "test:delete:instagram": "vitest run --config e2e/delete-instagram.vitest.config.ts",
    "test:engine": "vitest run --config e2e/engine-controls.vitest.config.ts",
    "test:fill": "playwright test --config e2e/fill.playwright.config.ts",
    "build:release": "node release/release.ts",
    "pack:check": "node release/pack-check.ts --plant-defect",
    "smoke:package": "node release/smoke.ts"
  },
  "dependencies": {
    "@socialprune/adapter-instagram": "workspace:*",
    "@socialprune/adapter-x": "workspace:*",
    "@socialprune/classify": "workspace:*",
    "@socialprune/core": "workspace:*",
    "@stricli/core": "1.3.0",
    "playwright-core": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "rolldown": "1.2.12"
  }
}
