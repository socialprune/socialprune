{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandPath": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string" }
          },
          "description": { "type": "string" },
          "positionals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "type": { "type": "string", "const": "string" },
                "required": { "type": "boolean" },
                "variadic": { "type": "boolean" },
                "minimum": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["name", "description", "type"],
              "additionalProperties": false
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "type": { "type": "string", "enum": ["boolean", "string"] },
                "default": { "$ref": "#/$defs/__schema0" },
                "required": { "type": "boolean" },
                "values": { "type": "array", "items": { "type": "string" } }
              },
              "required": [
                "name",
                "description",
                "type",
                "default",
                "required"
              ],
              "additionalProperties": false
            }
          },
          "outputSchemaIds": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          },
          "writes": { "type": "boolean" },
          "dryRun": { "type": "boolean" },
          "available": { "type": "boolean" }
        },
        "required": [
          "path",
          "description",
          "positionals",
          "options",
          "outputSchemaIds",
          "writes",
          "dryRun",
          "available"
        ],
        "additionalProperties": false
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "alias": { "type": "string" },
          "type": { "type": "string", "const": "boolean" },
          "default": { "type": "boolean" }
        },
        "required": ["name", "type", "default"],
        "additionalProperties": false
      }
    },
    "outputSchemaIds": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "errorSchemaId": {
      "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
    },
    "exitCodes": {
      "type": "object",
      "properties": {
        "0": { "type": "string", "const": "done" },
        "1": { "type": "string", "const": "runtime error" },
        "2": { "type": "string", "const": "wrong usage" },
        "3": {
          "type": "string",
          "const": "input format not readable by this version"
        },
        "4": { "type": "string", "const": "partial read" }
      },
      "required": ["0", "1", "2", "3", "4"],
      "additionalProperties": false
    }
  },
  "required": [
    "commandPath",
    "description",
    "commands",
    "options",
    "outputSchemaIds",
    "errorSchemaId",
    "exitCodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  },
  "$id": "https://socialprune.github.io/socialprune/schemas/cli-help.schema.json"
}
