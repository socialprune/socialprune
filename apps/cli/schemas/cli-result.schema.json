{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "command": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "status": { "type": "string", "enum": ["ok", "partial"] },
        "data": { "$ref": "#/$defs/__schema0" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "workspace": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["id", "revision"],
          "additionalProperties": false
        }
      },
      "required": ["schemaVersion", "command", "status", "data", "warnings"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "command": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "status": { "type": "string", "const": "error" },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "NO_TOKEN_CHANNEL" },
                "message": {
                  "type": "string",
                  "const": "The review URL can only be printed to a terminal on stderr. Run review in your own terminal."
                },
                "exitCode": { "type": "number", "const": 2 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "BROWSER_OPEN_FAILED" },
                "message": {
                  "type": "string",
                  "const": "Could not open the browser. Run review in your own terminal. The server stopped."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "REVIEW_ASSETS_MISSING" },
                "message": {
                  "type": "string",
                  "const": "The local review files are missing. Build or reinstall SocialPrune."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "REVIEW_FAILED" },
                "message": {
                  "type": "string",
                  "const": "Could not run the local review."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "INVALID_ARGUMENTS" },
                "message": {
                  "type": "string",
                  "const": "Invalid arguments. Use --help."
                },
                "exitCode": { "type": "number", "const": 2 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "INVALID_ARCHIVE_PATH" },
                "message": {
                  "type": "string",
                  "const": "Each path must name an existing ZIP file or directory."
                },
                "exitCode": { "type": "number", "const": 2 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "STRUCTURE_FAILED" },
                "message": {
                  "type": "string",
                  "const": "Could not describe the archive structure."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "SCHEMAS_FAILED" },
                "message": {
                  "type": "string",
                  "const": "Could not read the schema catalog."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "GUIDE_UNAVAILABLE" },
                "message": {
                  "type": "string",
                  "const": "The export guide is not yet verified. No platform was contacted."
                },
                "exitCode": { "type": "number", "const": 2 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "NOT_AVAILABLE" },
                "message": {
                  "type": "string",
                  "const": "This command is not available in this version."
                },
                "exitCode": { "type": "number", "const": 2 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "CANCELLED" },
                "message": {
                  "type": "string",
                  "const": "The command was cancelled."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "CLI_ERROR" },
                "message": {
                  "type": "string",
                  "const": "The command could not finish."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "NODE_TOO_OLD" },
                "message": {
                  "type": "string",
                  "pattern": "^SocialPrune needs Node\\.js 24\\.15 or newer for workspaces\\. You have \\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?\\.$"
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "MISSING_WORKSPACE" },
                "message": {
                  "type": "string",
                  "const": "Name a workspace directory containing socialprune.sqlite, or an empty directory for import or restore."
                },
                "exitCode": { "type": "number", "const": 2 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "WORKSPACE_BUSY" },
                "message": {
                  "type": "string",
                  "const": "The workspace is in use. Close the other command or review session and try again."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": true }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "WORKSPACE_SCHEMA_UNSUPPORTED"
                },
                "message": {
                  "type": "string",
                  "const": "This workspace needs a newer version of SocialPrune."
                },
                "exitCode": { "type": "number", "const": 3 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "WORKSPACE_INVALID" },
                "message": {
                  "type": "string",
                  "const": "The workspace database could not be read."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "const": "BACKUP_SCHEMA_UNSUPPORTED"
                },
                "message": {
                  "type": "string",
                  "const": "This backup needs a newer version of SocialPrune."
                },
                "exitCode": { "type": "number", "const": 3 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "BACKUP_INVALID" },
                "message": {
                  "type": "string",
                  "const": "The backup did not pass validation. The active workspace was not changed."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "BACKUP_CHANGED" },
                "message": {
                  "type": "string",
                  "const": "The workspace changed while the backup was written. Export it again."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": true }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "STORAGE_FULL" },
                "message": {
                  "type": "string",
                  "const": "There is not enough space to write the file or workspace."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "IO_ERROR" },
                "message": {
                  "type": "string",
                  "const": "Could not read or write the named file."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "UNKNOWN_FORMAT" },
                "message": {
                  "type": "string",
                  "const": "This version does not recognize the export format."
                },
                "exitCode": { "type": "number", "const": 3 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "HTML_EXPORT" },
                "message": {
                  "type": "string",
                  "const": "This is an HTML export. Request a JSON export from the platform."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "IMPORT_FAILED" },
                "message": {
                  "type": "string",
                  "const": "Could not finish the import. Run it again to complete it."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "SUMMARY_FAILED" },
                "message": {
                  "type": "string",
                  "const": "Could not read the workspace summary."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "BACKUP_FAILED" },
                "message": {
                  "type": "string",
                  "const": "Could not finish the backup."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "EXPORT_FAILED" },
                "message": {
                  "type": "string",
                  "const": "Could not finish the click-list export."
                },
                "exitCode": { "type": "number", "const": 1 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "code": { "type": "string", "const": "PARTIAL_IMPORT" },
                "message": {
                  "type": "string",
                  "const": "Some export data could not be imported."
                },
                "exitCode": { "type": "number", "const": 4 },
                "retryable": { "type": "boolean", "const": false }
              },
              "required": ["code", "message", "exitCode", "retryable"],
              "additionalProperties": false
            }
          ]
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["schemaVersion", "command", "status", "error", "warnings"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  },
  "$id": "https://socialprune.github.io/socialprune/schemas/cli-result.schema.json"
}
