{
  "name": "@socialprune/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "node build/package.ts",
    "test:unit": "vitest run --project desktop --maxWorkers=2",
    "test:e2e": "playwright test --workers=1",
    "test:red": "node build/red-controls.ts",
    "smoke": "node build/smoke.ts",
    "fuses:check": "node build/check-fuses.ts"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@electron/get": "5.1.0",
    "@electron-internal/extract-zip": "1.0.1",
    "@playwright/test": "1.63.0",
    "electron": "44.8.0",
    "resedit": "2.0.3",
    "rolldown": "1.2.12"
  }
}
