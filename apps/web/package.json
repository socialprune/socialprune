{
  "name": "@socialprune/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:review": "vite build --mode review",
    "build:review:check": "node scripts/review-build-check.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:all": "playwright test && playwright test --config playwright.probe.config.ts && node scripts/build-check.ts && pnpm test:e2e:review",
    "test:e2e:review": "pnpm build:review && playwright test --config playwright.review.config.ts && node scripts/review-build-check.ts",
    "build:release": "vite build --mode release",
    "guide:check": "node scripts/guide-check.ts",
    "i18n:generate": "node scripts/i18n-generate.ts",
    "i18n:check": "node scripts/i18n-check.ts",
    "measure:g1": "node scripts/measure-g1.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@socialprune/core": "workspace:*",
    "@socialprune/adapter-x": "workspace:*",
    "@socialprune/adapter-instagram": "workspace:*",
    "@tanstack/react-virtual": "3.14.13",
    "idb": "8.0.4",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@socialprune/fixture-gen": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "accessibility-checker-engine": "4.0.34",
    "esbuild": "0.28.2",
    "vite": "8.3.3"
  }
}
