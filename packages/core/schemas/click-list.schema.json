{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accountKey": { "type": "string", "minLength": 1 },
    "timeZone": { "type": "string", "minLength": 1 },
    "timeZoneSource": {
      "type": "string",
      "enum": ["flag", "workspace", "system"]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["post", "reply", "quote", "repost", "comment"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "outcome": {
            "type": "string",
            "enum": ["deleted-by-user", "skipped", "unknown"]
          },
          "action": {
            "type": "string",
            "enum": ["delete", "undo-repost", "delete-comment"]
          },
          "url": { "type": ["string", "null"] },
          "day": {
            "anyOf": [
              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              { "type": "null" }
            ]
          },
          "text": { "type": ["string", "null"] },
          "ownerHandle": { "type": ["string", "null"] },
          "via": { "type": "string", "enum": ["web-review", "local-review"] }
        },
        "required": [
          "itemId",
          "platform",
          "kind",
          "createdAt",
          "outcome",
          "action",
          "url",
          "day",
          "text",
          "ownerHandle",
          "via"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["accountKey", "timeZone", "timeZoneSource", "entries"],
  "additionalProperties": false,
  "$id": "https://socialprune.github.io/socialprune/schemas/click-list.schema.json"
}
