{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "importedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "archives": { "type": "array", "items": { "type": "string" } },
    "exportCreatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        { "type": "null" }
      ]
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "handle": { "type": ["string", "null"] }
        },
        "required": ["key", "handle"],
        "additionalProperties": false
      }
    },
    "adapter": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "variant": { "type": ["string", "null"] },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["found", "missing", "empty", "unreadable", "skipped"]
          },
          "files": { "type": "array", "items": { "type": "string" } },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "message": { "type": ["string", "null"] }
        },
        "required": ["category", "status", "files", "count", "message"],
        "additionalProperties": false
      }
    },
    "itemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": { "type": "string", "enum": ["complete", "incomplete"] }
  },
  "required": [
    "id",
    "platform",
    "importedAt",
    "archives",
    "exportCreatedAt",
    "accounts",
    "adapter",
    "variant",
    "diagnostics",
    "itemCount",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://socialprune.github.io/socialprune/schemas/import-record.schema.json"
}
