            },
            "expandClicks": { "type": "integer", "minimum": 0, "maximum": 10 }
          },
          "required": ["id", "createdAt", "expandClicks"],
          "additionalProperties": false
        }
      },
      "required": [
        "itemId",
        "accountKey",
        "post",
        "image",
        "screenshot",
        "confirmedAt",
        "runId",
        "attemptId",
        "ownerCheck",
        "confirmedBy",
        "comment"
      ],
      "additionalProperties": false
