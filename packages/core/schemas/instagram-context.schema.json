    {
      "type": "object",
      "properties": {
        "replies": {
          "type": "object",
          "properties": {
            "entries": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "account": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.]{1,30}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "createdAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      { "type": "null" }
                    ]
                  },
                  "likes": {
                    "type": "object",
                    "properties": {
                      "count": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          { "type": "null" }
                        ]
                      },
                      "source": {
                        "anyOf": [
                          { "type": "string", "enum": ["answer", "dom"] },
                          { "type": "null" }
                        ]
                      }
                    },
                    "required": ["count", "source"],
                    "additionalProperties": false
                  }
                },
                "required": ["account", "text", "createdAt", "likes"],
                "additionalProperties": false
              }
            },
            "moreCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "capped": { "type": "boolean" }
          },
          "required": ["entries", "moreCount", "capped"],
          "additionalProperties": false
        },
        "likes": {
          "type": "object",
          "properties": {
            "count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
