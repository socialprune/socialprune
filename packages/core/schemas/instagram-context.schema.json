              "type": "string",
              "enum": ["stored", "not-captured", "not-image", "too-large"]
            }
          },
          "required": ["file", "host", "status"],
          "additionalProperties": false
        },
        "screenshot": {
          "type": "object",
          "properties": {
            "file": {
              "anyOf": [
                { "type": "string", "const": "shot.jpg" },
                { "type": "null" }
              ]
            },
