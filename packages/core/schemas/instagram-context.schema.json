              "anyOf": [
                { "type": "string", "enum": ["answer", "dom"] },
                { "type": "null" }
              ]
            }
          },
          "required": ["count", "source"],
          "additionalProperties": false
        },
        "itemId": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^instagram:[^\\s:]+$"
        },
        "accountKey": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^instagram:[^\\s:]+$"
        },
        "post": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["p", "reel"] },
            "code": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^@\\s/]+$"
            },
            "ownerCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "createdAt": {
