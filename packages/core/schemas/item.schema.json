{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "account": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "handle": { "type": ["string", "null"] }
      },
      "required": ["key", "handle"],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": ["post", "reply", "quote", "repost", "comment"]
    },
    "text": { "type": "string" },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "engagement": {
      "type": "object",
      "properties": {
        "likes": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "reposts": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        }
      },
      "required": ["likes", "reposts"],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "replyToId": { "type": ["string", "null"] },
        "replyToHandle": { "type": ["string", "null"] },
        "quotedId": { "type": ["string", "null"] },
        "repostOfHandle": { "type": ["string", "null"] },
        "ownerHandle": { "type": ["string", "null"] }
      },
      "required": [
        "replyToId",
        "replyToHandle",
        "quotedId",
        "repostOfHandle",
        "ownerHandle"
      ],
      "additionalProperties": false
    },
    "url": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "properties": {
        "archive": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["archive", "file", "index"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "platform",
    "account",
    "kind",
    "text",
    "createdAt",
    "engagement",
    "reference",
    "url",
    "provenance"
  ],
  "additionalProperties": false,
  "$id": "https://socialprune.github.io/socialprune/schemas/item.schema.json"
}
