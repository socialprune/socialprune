{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{1,40}$" },
    "anonymous": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["fetched", "not-found", "tombstone", "failed"]
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": ["status", "at"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "signedIn": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["read", "not-found", "tombstone", "unavailable"]
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "runId": { "type": "string", "minLength": 1 },
            "attemptId": { "type": "string", "minLength": 1 },
            "reason": {
              "anyOf": [
                { "type": "string", "maxLength": 500 },
                { "type": "null" }
              ]
            }
          },
          "required": ["status", "at", "runId", "attemptId", "reason"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "text": {
      "anyOf": [{ "type": "string", "maxLength": 1000000 }, { "type": "null" }]
    },
    "authorName": {
      "anyOf": [{ "type": "string", "maxLength": 4096 }, { "type": "null" }]
    },
    "authorHandle": {
      "anyOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }]
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        { "type": "null" }
      ]
    },
    "textSource": {
      "anyOf": [
        { "type": "string", "enum": ["anonymous", "signed-in"] },
        { "type": "null" }
      ]
    },
    "textCompleteness": {
      "type": "string",
      "enum": ["unknown", "truncated", "full"]
    },
    "media": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": { "type": "integer", "minimum": 1, "maximum": 4 },
          "kind": { "type": "string", "enum": ["photo", "video", "gif"] },
          "source": { "type": "string", "enum": ["anonymous", "signed-in"] },
          "url": {
            "anyOf": [
              { "type": "string", "maxLength": 4096 },
              { "type": "null" }
            ]
          },
          "file": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-4]\\.(?:jpg|png|gif|webp|mp4)$"
              },
              { "type": "null" }
            ]
          },
          "poster": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-4]-poster\\.(?:jpg|png|webp)$"
              },
              { "type": "null" }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "stored",
              "failed",
              "refused",
              "too-large",
              "hls-only",
              "no-variant",
              "run-cap",
              "not-stored"
            ]
          },
          "bytes": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "durationMs": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "bitrateLabel": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "altText": {
            "anyOf": [
              { "type": "string", "maxLength": 1000 },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "n",
          "kind",
          "source",
          "url",
          "file",
          "poster",
          "status",
          "bytes",
          "durationMs",
          "bitrateLabel",
          "altText"
        ],
        "additionalProperties": false
      }
    },
    "quotedId": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{1,40}$" },
        { "type": "null" }
      ]
    },
    "parentId": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{1,40}$" },
        { "type": "null" }
      ]
    },
    "conversationId": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{1,40}$" },
        { "type": "null" }
      ]
    },
    "chainAbove": {
      "anyOf": [
        { "type": "string", "enum": ["complete", "partial"] },
        { "type": "null" }
      ]
    },
    "raw": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        },
        { "type": "null" }
      ]
    },
    "signedInRecord": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rest_id": { "type": "string", "pattern": "^[0-9]{1,40}$" },
            "text": { "type": "string", "maxLength": 1000000 },
            "author": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "maxLength": 4096 },
                "screen_name": { "type": "string", "maxLength": 512 }
              },
              "required": ["name", "screen_name"],
              "additionalProperties": false
            },
            "created_at": { "type": ["string", "null"] },
            "conversation_id_str": {
              "anyOf": [
                { "type": "string", "pattern": "^[0-9]{1,40}$" },
                { "type": "null" }
              ]
            },
            "in_reply_to_status_id_str": {
              "anyOf": [
                { "type": "string", "pattern": "^[0-9]{1,40}$" },
                { "type": "null" }
              ]
            },
            "quoted_status_id_str": {
              "anyOf": [
                { "type": "string", "pattern": "^[0-9]{1,40}$" },
                { "type": "null" }
              ]
            },
            "mediaDetails": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["photo", "video", "animated_gif"]
                  },
                  "media_url_https": { "type": "string", "maxLength": 4096 },
                  "ext_alt_text": {
                    "anyOf": [
                      { "type": "string", "maxLength": 1000 },
                      { "type": "null" }
                    ]
                  },
                  "video_info": {
                    "type": "object",
                    "properties": {
                      "duration_millis": {
                        "anyOf": [
                          { "type": "number", "minimum": 0 },
                          { "type": "null" }
                        ]
                      },
                      "variants": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "content_type": {
                              "type": "string",
                              "enum": ["video/mp4", "application/x-mpegURL"]
                            },
                            "url": { "type": "string", "maxLength": 4096 },
                            "bitrate": { "type": "number", "minimum": 0 }
                          },
                          "required": ["content_type", "url"],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": ["duration_millis", "variants"],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "media_url_https",
                  "ext_alt_text",
                  "video_info"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["rest_id", "text"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "id",
    "anonymous",
    "signedIn",
    "text",
    "authorName",
    "authorHandle",
    "createdAt",
    "textSource",
    "textCompleteness",
    "media",
    "quotedId",
    "parentId",
    "conversationId",
    "chainAbove",
    "raw",
    "signedInRecord"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  },
  "$id": "https://socialprune.github.io/socialprune/schemas/original.schema.json"
}
