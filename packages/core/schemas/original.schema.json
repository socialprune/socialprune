{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{1,40}$" },
    "status": {
      "type": "string",
      "enum": ["fetched", "not-found", "tombstone", "failed"]
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "text": {
      "anyOf": [{ "type": "string", "maxLength": 1000000 }, { "type": "null" }]
    },
    "authorName": {
      "anyOf": [{ "type": "string", "maxLength": 4096 }, { "type": "null" }]
    },
    "authorHandle": {
      "anyOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }]
    },
    "photos": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "maxLength": 4096 },
          "file": {
            "anyOf": [
              { "type": "string", "pattern": "^[1-4]\\.(?:jpg|png|gif|webp)$" },
              { "type": "null" }
            ]
          },
          "status": { "type": "string", "enum": ["stored", "failed"] }
        },
        "required": ["url", "file", "status"],
        "additionalProperties": false
      }
    },
    "quotedId": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{1,40}$" },
        { "type": "null" }
      ]
    },
    "parentId": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{1,40}$" },
        { "type": "null" }
      ]
    },
    "raw": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        },
        { "type": "null" }
      ]
    },
    "textCompleteness": { "type": "string", "enum": ["unknown", "truncated"] },
    "video": {
      "anyOf": [{ "type": "string", "const": "not-stored" }, { "type": "null" }]
    }
  },
  "required": [
    "id",
    "status",
    "fetchedAt",
    "text",
    "authorName",
    "authorHandle",
    "photos",
    "quotedId",
    "parentId",
    "raw",
    "textCompleteness",
    "video"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  },
  "$id": "https://socialprune.github.io/socialprune/schemas/original.schema.json"
}
