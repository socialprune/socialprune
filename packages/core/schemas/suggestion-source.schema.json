{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9._-]{1,32}$" },
    "baseUrl": { "type": "string", "format": "uri" },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "keyFile": { "type": "string", "minLength": 1 },
    "profile": {
      "type": "string",
      "enum": ["openai-compatible", "llama-server", "ollama", "openrouter"]
    },
    "structuredOutput": {
      "type": "string",
      "enum": ["json_schema", "json_object", "none"]
    },
    "cacheControl": { "type": "boolean" },
    "entriesPerRequest": { "type": "integer", "minimum": 1, "maximum": 50 },
    "parallelRequests": { "type": "integer", "minimum": 1, "maximum": 4 },
    "requestTimeoutSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 600
    },
    "allowPaid": { "type": "boolean" },
    "check": {
      "type": "object",
      "properties": {
        "origin": { "type": "string", "format": "uri" },
        "answeringModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rubricVersion": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "origin",
        "answeringModel",
        "rubricVersion",
        "checkedAt",
        "configurationHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "baseUrl",
    "model",
    "entriesPerRequest"
  ],
  "additionalProperties": false,
  "$id": "https://socialprune.github.io/socialprune/schemas/suggestion-source.schema.json"
}
