{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "number", "const": 2 },
    "kind": { "type": "string", "enum": ["personal", "demo"] },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "counts": {
      "type": "object",
      "properties": {
        "imports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assessments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "submissions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decisionEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outcomeEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "imports",
        "items",
        "assessments",
        "submissions",
        "decisionEvents",
        "outcomeEvents"
      ],
      "additionalProperties": false
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["key", "items"],
        "additionalProperties": false
      }
    },
    "kinds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["post", "reply", "quote", "repost", "comment"]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "required": ["post", "reply", "quote", "repost", "comment"]
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["rules", "model", "agent", "fixture"]
          },
          "name": { "type": "string", "minLength": 1 },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["kind", "name", "count"],
        "additionalProperties": false
      }
    },
    "withoutAgentAssessment": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decisions": {
      "type": "object",
      "properties": {
        "keep": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "delete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "later": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "undecided": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["keep", "delete", "later", "undecided"],
      "additionalProperties": false
    },
    "decisionSources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "via": { "type": "string", "enum": ["web-review", "local-review"] },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["via", "count"],
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "deleted-by-user": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["deleted-by-user", "skipped", "unknown"],
      "additionalProperties": false
    },
    "lastImportAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        { "type": "null" }
      ]
    },
    "lastBackupAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "workspaceId",
    "schemaVersion",
    "kind",
    "revision",
    "counts",
    "accounts",
    "kinds",
    "assessments",
    "withoutAgentAssessment",
    "decisions",
    "decisionSources",
    "outcomes",
    "lastImportAt",
    "lastBackupAt"
  ],
  "additionalProperties": false,
  "$id": "https://socialprune.github.io/socialprune/schemas/summary.schema.json"
}
