{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "itemId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["rules", "model", "agent"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] }
      },
      "required": ["kind", "name", "version"],
      "additionalProperties": false
    },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "risk": { "type": "integer", "minimum": 0, "maximum": 3 },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*[.!?]\\s+\\S)(?![\\s\\S]*[\\r\\n])[\\s\\S]+$"
    },
    "evidence": { "type": ["string", "null"] },
    "confidence": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "itemId",
    "source",
    "category",
    "risk",
    "reason",
    "evidence",
    "confidence",
    "createdAt"
  ],
  "additionalProperties": false,
  "$id": "https://socialprune.github.io/socialprune/schemas/v1/assessment.schema.json"
}
