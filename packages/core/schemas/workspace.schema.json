{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "settings": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
        }
      },
      "required": ["categories"],
      "additionalProperties": false
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "importedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "archives": { "type": "array", "items": { "type": "string" } },
          "exportCreatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              { "type": "null" }
            ]
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "handle": { "type": ["string", "null"] }
              },
              "required": ["key", "handle"],
              "additionalProperties": false
            }
          },
          "adapter": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "required": ["name", "version"],
            "additionalProperties": false
          },
          "variant": { "type": ["string", "null"] },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": { "type": "string", "minLength": 1 },
                "status": {
                  "type": "string",
                  "enum": ["found", "missing", "empty", "unreadable", "skipped"]
                },
                "files": { "type": "array", "items": { "type": "string" } },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "message": { "type": ["string", "null"] }
              },
              "required": ["category", "status", "files", "count", "message"],
              "additionalProperties": false
            }
          },
          "itemCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "platform",
          "importedAt",
          "archives",
          "exportCreatedAt",
          "accounts",
          "adapter",
          "variant",
          "diagnostics",
          "itemCount"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "account": {
            "type": "object",
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "handle": { "type": ["string", "null"] }
            },
            "required": ["key", "handle"],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "enum": ["post", "reply", "quote", "repost", "comment"]
          },
          "text": { "type": "string" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "engagement": {
            "type": "object",
            "properties": {
              "likes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "reposts": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              }
            },
            "required": ["likes", "reposts"],
            "additionalProperties": false
          },
          "reference": {
            "type": "object",
            "properties": {
              "replyToId": { "type": ["string", "null"] },
              "replyToHandle": { "type": ["string", "null"] },
              "quotedId": { "type": ["string", "null"] },
              "repostOfHandle": { "type": ["string", "null"] },
              "ownerHandle": { "type": ["string", "null"] }
            },
            "required": [
              "replyToId",
              "replyToHandle",
              "quotedId",
              "repostOfHandle",
              "ownerHandle"
            ],
            "additionalProperties": false
          },
          "url": { "type": ["string", "null"] },
          "provenance": {
            "type": "object",
            "properties": {
              "archive": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["archive", "file", "index"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "platform",
          "account",
          "kind",
          "text",
          "createdAt",
          "engagement",
          "reference",
          "url",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "enum": ["rules", "model", "agent"] },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "null"] }
            },
            "required": ["kind", "name", "version"],
            "additionalProperties": false
          },
          "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "risk": { "type": "integer", "minimum": 0, "maximum": 3 },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*[.!?]\\s+\\S)(?![\\s\\S]*[\\r\\n])[\\s\\S]+$"
          },
          "evidence": { "type": ["string", "null"] },
          "confidence": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "itemId",
          "source",
          "category",
          "risk",
          "reason",
          "evidence",
          "confidence",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "enum": ["keep", "delete", "later"] },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "human" },
              "via": {
                "type": "string",
                "enum": ["web-review", "local-review"]
              }
            },
            "required": ["kind", "via"],
            "additionalProperties": false
          }
        },
        "required": ["itemId", "value", "decidedAt", "source"],
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "value": {
            "type": "string",
            "enum": ["deleted-by-user", "skipped", "unknown"]
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["itemId", "value", "recordedAt"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "settings",
    "imports",
    "items",
    "assessments",
    "decisions",
    "outcomes"
  ],
  "additionalProperties": false,
  "$id": "https://socialprune.github.io/socialprune/schemas/workspace.schema.json"
}
