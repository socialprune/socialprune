{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "socialprune-workspace" },
    "schemaVersion": { "type": "number", "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["personal", "demo"] },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "lastBackupAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        { "type": "null" }
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "categories": {
          "maxItems": 32,
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
        },
        "timeZone": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": ["categories", "timeZone"],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "imports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assessments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "submissions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decisionEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outcomeEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "imports",
        "items",
        "assessments",
        "submissions",
        "decisionEvents",
        "outcomeEvents"
      ],
      "additionalProperties": false
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "importedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "archives": { "type": "array", "items": { "type": "string" } },
          "exportCreatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              { "type": "null" }
            ]
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "handle": { "type": ["string", "null"] }
              },
              "required": ["key", "handle"],
              "additionalProperties": false
            }
          },
          "adapter": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "required": ["name", "version"],
            "additionalProperties": false
          },
          "variant": { "type": ["string", "null"] },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": { "type": "string", "minLength": 1 },
                "status": {
                  "type": "string",
                  "enum": ["found", "missing", "empty", "unreadable", "skipped"]
                },
                "files": { "type": "array", "items": { "type": "string" } },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "message": { "type": ["string", "null"] }
              },
              "required": ["category", "status", "files", "count", "message"],
              "additionalProperties": false
            }
          },
          "itemCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": { "type": "string", "enum": ["complete", "incomplete"] }
        },
        "required": [
          "id",
          "platform",
          "importedAt",
          "archives",
          "exportCreatedAt",
          "accounts",
          "adapter",
          "variant",
          "diagnostics",
          "itemCount",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "account": {
            "type": "object",
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "handle": { "type": ["string", "null"] }
            },
            "required": ["key", "handle"],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "enum": ["post", "reply", "quote", "repost", "comment"]
          },
          "text": { "type": "string" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "engagement": {
            "type": "object",
            "properties": {
              "likes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "reposts": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              }
            },
            "required": ["likes", "reposts"],
            "additionalProperties": false
          },
          "reference": {
            "type": "object",
            "properties": {
              "replyToId": { "type": ["string", "null"] },
              "replyToHandle": { "type": ["string", "null"] },
              "quotedId": { "type": ["string", "null"] },
              "repostOfHandle": { "type": ["string", "null"] },
              "ownerHandle": { "type": ["string", "null"] }
            },
            "required": [
              "replyToId",
              "replyToHandle",
              "quotedId",
              "repostOfHandle",
              "ownerHandle"
            ],
            "additionalProperties": false
          },
          "url": { "type": ["string", "null"] },
          "provenance": {
            "type": "object",
            "properties": {
              "archive": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["archive", "file", "index"],
            "additionalProperties": false
          },
          "mediaCount": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "id",
          "platform",
          "account",
          "kind",
          "text",
          "createdAt",
          "engagement",
          "reference",
          "url",
          "provenance",
          "mediaCount"
        ],
        "additionalProperties": false
      }
    },
    "submissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "agent" },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "null"] }
            },
            "required": ["kind", "name", "version"],
            "additionalProperties": false
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "labelCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "submissionId",
          "contentHash",
          "source",
          "receivedAt",
          "labelCount"
        ],
        "additionalProperties": false
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["rules", "model", "agent", "fixture"]
              },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "null"] }
            },
            "required": ["kind", "name", "version"],
            "additionalProperties": false
          },
          "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "risk": { "type": "integer", "minimum": 0, "maximum": 3 },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*[.!?]\\s+\\S)(?![\\s\\S]*[\\r\\n])[\\s\\S]+$"
          },
          "evidence": { "type": ["string", "null"] },
          "confidence": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "assessmentId": { "type": "string", "minLength": 1 },
          "submissionId": {
            "anyOf": [
              { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "itemId",
          "source",
          "category",
          "risk",
          "reason",
          "evidence",
          "confidence",
          "createdAt",
          "assessmentId",
          "submissionId"
        ],
        "additionalProperties": false
      }
    },
    "decisionEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "itemId": { "type": "string", "minLength": 1 },
          "value": {
            "type": "string",
            "enum": ["keep", "delete", "later", "undecided"]
          },
          "previous": {
            "type": "string",
            "enum": ["keep", "delete", "later", "undecided"]
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "human" },
              "via": {
                "type": "string",
                "enum": ["web-review", "local-review"]
              }
            },
            "required": ["kind", "via"],
            "additionalProperties": false
          },
          "action": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": ["single", "bulk", "undo", "redo", "migrated"]
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "reverts": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              }
            },
            "required": ["id", "kind", "size", "reverts"],
            "additionalProperties": false
          }
        },
        "required": [
          "eventId",
          "itemId",
          "value",
          "previous",
          "decidedAt",
          "source",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "outcomeEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "itemId": { "type": "string", "minLength": 1 },
          "value": {
            "type": "string",
            "enum": ["deleted-by-user", "skipped", "unknown"]
          },
          "previous": {
            "type": "string",
            "enum": ["deleted-by-user", "skipped", "unknown"]
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "human" },
              "via": {
                "type": "string",
                "enum": ["web-review", "local-review", "v1-unrecorded"]
              }
            },
            "required": ["kind", "via"],
            "additionalProperties": false
          },
          "action": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": ["single", "bulk", "undo", "redo", "migrated"]
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "reverts": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              }
            },
            "required": ["id", "kind", "size", "reverts"],
            "additionalProperties": false
          }
        },
        "required": [
          "eventId",
          "itemId",
          "value",
          "previous",
          "recordedAt",
          "source",
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "id",
    "kind",
    "createdAt",
    "updatedAt",
    "lastBackupAt",
    "settings",
    "counts",
    "imports",
    "items",
    "submissions",
    "assessments",
    "decisionEvents",
    "outcomeEvents"
  ],
  "additionalProperties": false,
  "$id": "https://socialprune.github.io/socialprune/schemas/workspace.schema.json"
}
